# Slack — tạo app tại https://api.slack.com/apps (xem README)
# Bot User OAuth Token, scope: chat:write
SLACK_BOT_TOKEN=xoxb-...
# ID kênh nhận thông báo (bấm tên kênh -> cuối popup có Channel ID, dạng C0123ABCD)
SLACK_CHANNEL_ID=C0123ABCD

# URL gốc của GitHub Pages, KHÔNG có dấu / ở cuối
PAGES_BASE_URL=https://<user>.github.io/esports-hub

# Chỉ dùng cho Cloudflare Worker (worker/.dev.vars), không cần cho GitHub Actions
SLACK_SIGNING_SECRET=...

# Đặt =1 để in ra stdout thay vì gửi Slack
DRY_RUN=
