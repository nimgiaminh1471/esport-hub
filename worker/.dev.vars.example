# Copy thành worker/.dev.vars để chạy `npx wrangler dev`.
# Lấy ở Slack App -> Basic Information -> App Credentials -> Signing Secret.
SLACK_SIGNING_SECRET=...

# Để `/note chot` đăng được tổng kết cuối ngày vào kênh.
# Bỏ trống thì lệnh vẫn ghi KV, chỉ không gửi Slack — tiện khi thử.
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0123ABCD

# Phần của đối tác, 0–1. Ngày lãi chia đôi, ngày lỗ đối tác gánh 3/10.
DOI_TAC_SHARE=0.5
DOI_TAC_SHARE_LO=0.3
